#!/usr/bin/env bash
# AWS credential_process helper: prints the stored `aws` base credentials as the JSON the
# AWS CLI and SDKs expect from a `credential_process` command.
#
# The generated ~/.aws/config names this script in its base profile, and every role
# profile uses that profile as `source_profile`. The credential store is read on every
# call, so `archie auth login aws` on the host applies to running sessions without a
# restart. Nothing is written and no credential is kept in the container environment.
#
# Exit codes: 0 credentials printed, 1 no usable credentials (message on stderr).

set -u

home="${ARCHIE_HOME_DIR:-${HOME:-}/.nexus}"
credentials="$home/credentials.yaml"

fail() {
    printf 'archie aws credentials: %s\n' "$*" >&2
    exit 1
}

[[ -f $credentials ]] || fail "no credential store at $credentials; run 'archie auth login aws' on the host"

# Strings only: a missing or non-string field prints nothing.
read_field() {
    yq -r ".aws.$1 | select(tag == \"!!str\")" "$credentials" 2>/dev/null
}

if ! access_key=$(read_field access_key_id); then
    fail "could not read $credentials"
fi
secret_key=$(read_field secret_access_key)
session_token=$(read_field session_token)

if [[ -z $access_key || -z $secret_key ]]; then
    fail "aws credentials are not set; run 'archie auth login aws' on the host"
fi

# Expiration is a re-read interval, not the session token's real expiry (login does not
# record that). AWS clients refresh credentials 15 minutes before Expiration, so 20 minutes
# makes a long-running SDK session re-run this script about every 5 minutes. Without it,
# the session would keep the first credentials for its lifetime.
expiration=$(date -u -d '+20 minutes' '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null ||
    date -u -v+20M '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || fail "could not compute expiration"

# jq builds the JSON so values are escaped; the session token is optional.
exec jq -n \
    --arg access_key "$access_key" \
    --arg secret_key "$secret_key" \
    --arg session_token "$session_token" \
    --arg expiration "$expiration" \
    '{Version: 1, AccessKeyId: $access_key, SecretAccessKey: $secret_key, Expiration: $expiration}
     + (if $session_token == "" then {} else {SessionToken: $session_token} end)'
