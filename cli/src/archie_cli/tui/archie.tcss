/*
 * archie.tcss — Visual theme styling.
 *
 * Structural layout (height, margin, padding, overflow) lives in each widget's
 * DEFAULT_CSS. This file contains only visual properties: colours, backgrounds,
 * borders and text styles.
 *
 * Textual loads this via CSS_PATH on the App class — it takes higher specificity
 * than DEFAULT_CSS, so visual overrides here always win.
 */

/* --- Screen --- */
Screen {
    background: $surface;
    /* The Conversation (VerticalScroll) owns scrolling — the Screen must not
     * add its own scrollbar, otherwise a second (dead) scrollbar appears. */
    overflow-x: hidden;
    overflow-y: hidden;
    scrollbar-size: 0 0;
}

/* --- Conversation area --- */
Conversation {
    background: black;
    /* Only a vertical scrollbar; horizontal content is wrapped/clipped. */
    overflow-x: hidden;
    overflow-y: auto;
}

/* --- Message borders --- */
UserMessage {
    border-left: thick $primary;
}

/* A dim rule on assistant text; streaming matches so finalising doesn't shift it. */
AssistantMessage {
    border-left: thick $primary 30%;
}

AssistantMessage > .header {
    color: $success;
    text-style: bold;
}

StreamingMessage {
    border-left: thick $primary 30%;
}

StreamingMessage > .header {
    color: $success;
    text-style: bold;
}

QuestionPanel {
    border-left: thick $primary;
}

CancelledMessage {
    border-left: thick $error-darken-3;
    color: $error;
}

ErrorMessage {
    border-left: thick $error-darken-3;
    color: $error;
}

ShellOutput {
    border-left: thick transparent;
    background: $surface-darken-1;
}

/* Iteration blocks keep the transparent border from DEFAULT_CSS, so their tool rows
 * line up with message text; the blank line between blocks separates iterations. */

/* --- Status bar colours --- */
StatusBar {
    color: $muted;
}

StatusBar #status-left {
    color: auto;
}

StatusBar #status-right {
    color: auto;
}

/* --- Input styling --- */
MessageInput {
    border: round $surface-lighten-2;

    & .text-area--cursor-line {
        background: $surface;
    }
}

MessageInput:focus {
    border: round $primary;
}

/* --- Footer --- */
Footer {
    height: 2;
    padding: 1 0 0 0;
}
