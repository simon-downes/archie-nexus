/*
 * archie.tcss — Visual theme styling.
 *
 * Structural layout (height, margin, padding, overflow) lives in each widget's
 * DEFAULT_CSS. This file contains only visual properties: colours, backgrounds,
 * borders and text styles.
 *
 * Textual loads this via CSS_PATH on the App class — it takes higher specificity
 * than DEFAULT_CSS, so visual overrides here always win.
 */

/* --- Screen --- */
Screen {
    background: $surface;
    /* The Conversation (VerticalScroll) owns scrolling — the Screen must not
     * add its own scrollbar, otherwise a second (dead) scrollbar appears. */
    overflow-x: hidden;
    overflow-y: hidden;
    scrollbar-size: 0 0;
}

/* --- Sidebar --- */
Sidebar {
    background: $surface;
    border-right: tall $surface-lighten-1;
}

SessionList {
    background: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $surface-lighten-2;
    scrollbar-color-hover: $primary 60%;
    scrollbar-color-active: $primary;
}

/* The profile name is a link to the web interface. */
Sidebar > .sidebar-info {
    link-color: $link;
    link-style: none;
    link-color-hover: $link;
    link-background-hover: transparent;
    link-style-hover: underline;
}

/* Notices (notices.py): a card with a bar on the left coloured by severity. */
Notice {
    background: $surface-lighten-1;
    border-left: thick $primary;
}

Notice.-warning {
    border-left: thick $warning;
}

Notice.-error {
    border-left: thick $error;
}

EmptyPane {
    color: $muted;
}

/* The sidebar's filter: a rounded field like the message input. */
SessionFilter {
    border: round $surface-lighten-2;
    background: $surface;
}

SessionFilter:focus {
    border: round $primary;
}

/* --- Dialogs and the palette (dialogs.py, commands.py) ---
 * The Screen rule above gives every screen an opaque background, modal ones included;
 * these restore the see-through backdrop so the window stays visible, and live, behind
 * them. A session dialog (-pane) is nearly transparent: the app dims the session pane
 * instead (Main.-dimmed), so the sidebar stays bright. */
Dialog,
CommandPalette {
    background: $background 60%;
}

Dialog.-pane {
    background: $background 1%;
}

/* Tint doesn't cascade, so every widget in the dimmed area takes it. */
Main.-dimmed,
Main.-dimmed * {
    tint: $background 60%;
}

/* --- Session pane --- */
SessionHeader {
    background: $surface;
}

/* The transcript sits on $pane: a step darker than the surface around it, not black.
 * The activity line under it is the transcript's last row, on the same colour. */
SessionPane > .pane-loading,
ActivityLine {
    background: $pane;
}

/* --- Conversation area --- */
/* One column of padding keeps the blocks' left bars off the sidebar's divider; the
 * scrollbar is a quiet one-cell thumb on the transcript's own colour. */
Conversation {
    background: $pane;
    padding-left: 1;
    /* Only a vertical scrollbar; horizontal content is wrapped/clipped. */
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    scrollbar-background: $pane;
    scrollbar-background-hover: $pane;
    scrollbar-background-active: $pane;
    scrollbar-color: $surface-lighten-2;
    scrollbar-color-hover: $primary 60%;
    scrollbar-color-active: $primary;
}

/* Tool rows are names in bright blue over muted targets (transcript_view.ToolRow);
 * the rows of consecutive iterations stack with no gap, and every other block is one
 * blank line from its neighbours (each has a one-line margin; adjacent margins
 * collapse). */

/* --- Message borders --- */
/* Your messages: a purple bar and no header. */
UserMessage {
    border-left: thick $primary;
}

/* A subagent's task prompt sits where a user message would. */
PromptMessage {
    border-left: thick $primary;
}

/* Archie's replies: no header and no visible rule. The rule stays as a transparent
 * column so reply text lines up with the tool rows; streaming matches so finalising
 * doesn't shift it. */
AssistantMessage,
StreamingMessage {
    border-left: thick transparent;
}

/* Every Markdown block ends with a one-line bottom margin, so a reply's last block
 * would add a blank line to the message's own margin. A negative margin on the
 * Markdown takes it back; a `:last-child` rule does the same but restyling it made
 * switching to a large session ~0.45 s slower. */
AssistantMessage > Markdown,
StreamingMessage > Markdown {
    margin-bottom: -1;
}

QuestionPanel {
    border-left: thick $primary;
}

CancelledMessage {
    border-left: thick $error-darken-3;
    color: $error;
}

ErrorMessage {
    border-left: thick $error-darken-3;
    color: $error;
}

ShellOutput {
    border-left: thick transparent;
    background: $surface-darken-1;
}

/* Iteration blocks keep the transparent border from DEFAULT_CSS, so their tool rows
 * line up with message text. */

/* --- Detail views (detail.py) ---
 * They take the transcript's place on its colour. A headline card on the surface
 * colour, then one band per section (title left, facts right), which also divides
 * it from the section before; a failed call's result has a red band. */
DetailView,
DetailView .detail-body {
    background: $pane;
}

DetailView .detail-body {
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-vertical: 1;
    scrollbar-background: $pane;
    scrollbar-background-hover: $pane;
    scrollbar-background-active: $pane;
    scrollbar-color: $surface-lighten-2;
    scrollbar-color-hover: $primary 60%;
    scrollbar-color-active: $primary;
}

DetailView .detail-card {
    background: $surface;
}

SectionPanel > .section-band {
    background: $surface-lighten-1;
}

SectionPanel .section-title {
    color: $secondary;
    text-style: bold;
}

SectionPanel .section-facts {
    color: $muted;
}

SectionPanel.-error > .section-band {
    background: $error 25%;
}

SectionPanel.-error .section-title {
    color: $error;
}

/* --- Status bar colours --- */
StatusBar {
    color: $foreground;
}

/* --- Input styling --- */
MessageInput {
    border: round $surface-lighten-2;

    & .text-area--cursor-line {
        background: $surface;
    }
}

MessageInput:focus {
    border: round $primary;
}
