/*
 * archie.tcss — Visual theme styling.
 *
 * Structural layout (height, margin, padding, overflow) lives in each widget's
 * DEFAULT_CSS. This file contains only visual properties: colours, backgrounds,
 * borders and text styles.
 *
 * Textual loads this via CSS_PATH on the App class — it takes higher specificity
 * than DEFAULT_CSS, so visual overrides here always win.
 */

/* --- Screen --- */
Screen {
    background: $surface;
    /* The Conversation (VerticalScroll) owns scrolling — the Screen must not
     * add its own scrollbar, otherwise a second (dead) scrollbar appears. */
    overflow-x: hidden;
    overflow-y: hidden;
    scrollbar-size: 0 0;
}

/* --- Sidebar --- */
Sidebar {
    background: $surface;
    border-right: tall $surface-lighten-1;
}

SessionList {
    background: $surface;
    scrollbar-size-vertical: 1;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
    scrollbar-color: $surface-lighten-2;
    scrollbar-color-hover: $primary 60%;
    scrollbar-color-active: $primary;
}

/* The profile name is a link to the web interface. */
Sidebar > .sidebar-info {
    link-color: #5fafff;
    link-style: none;
    link-color-hover: #5fafff;
    link-background-hover: transparent;
    link-style-hover: underline;
}

EmptyPane {
    color: $muted;
}

/* --- Session pane --- */
SessionHeader {
    background: $surface;
}

/* The transcript sits on $pane: a step darker than the surface around it, not black. */
SessionPane > .pane-loading,
ThrobberContainer,
Throbber {
    background: $pane;
}

/* --- Conversation area --- */
Conversation {
    background: $pane;
    /* Only a vertical scrollbar; horizontal content is wrapped/clipped. */
    overflow-x: hidden;
    overflow-y: auto;
}

/* --- Message borders --- */
UserMessage {
    border-left: thick $primary;
}

/* A subagent's task prompt sits where a user message would. */
PromptMessage {
    border-left: thick $primary;
}

/* A dim rule on assistant text; streaming matches so finalising doesn't shift it. */
AssistantMessage {
    border-left: thick $primary 30%;
}

AssistantMessage > .header {
    color: $success;
    text-style: bold;
}

StreamingMessage {
    border-left: thick $primary 30%;
}

StreamingMessage > .header {
    color: $success;
    text-style: bold;
}

QuestionPanel {
    border-left: thick $primary;
}

CancelledMessage {
    border-left: thick $error-darken-3;
    color: $error;
}

ErrorMessage {
    border-left: thick $error-darken-3;
    color: $error;
}

ShellOutput {
    border-left: thick transparent;
    background: $surface-darken-1;
}

/* Iteration blocks keep the transparent border from DEFAULT_CSS, so their tool rows
 * line up with message text; the blank line between blocks separates iterations. */

/* --- Status bar colours --- */
StatusBar {
    color: $muted;
}

StatusBar #status-left {
    color: auto;
}

StatusBar #status-right {
    color: auto;
}

/* --- Input styling --- */
MessageInput {
    border: round $surface-lighten-2;

    & .text-area--cursor-line {
        background: $surface;
    }
}

MessageInput:focus {
    border: round $primary;
}
