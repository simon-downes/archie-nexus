/*
 * prototype.tcss: layout and colours for the multi-session prototype.
 * Loaded after archie.tcss, so the attach TUI's message and input styles still apply.
 */

#body {
    height: 1fr;
}

/* --- Scrollbars ---
 * One style for every scrolling area: a one-cell grey thumb on the area's own
 * background (set per area below), purple while hovered or dragged. */
SessionList,
#views Conversation,
#views TranscriptView,
PaneView VerticalScroll,
MessageInput {
    scrollbar-size-vertical: 1;
    scrollbar-color: $surface-lighten-2;
    scrollbar-color-hover: $primary 60%;
    scrollbar-color-active: $primary;
}

MessageInput {
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;
}

/* --- Sidebar (fixed; dialogs.SIDEBAR_WIDTH must match the width) --- */
#sidebar {
    width: 48;
    height: 1fr;
    background: $surface;
    border-right: tall $surface-lighten-1;
}

#brand {
    height: auto;
    padding: 1 1 0 2;
}

/* Under the banner; the profile name is a link to the web interface. */
#brand-info {
    height: auto;
    padding: 0 1 0 2;
    link-color: #5fafff;
    link-style: none;
    link-color-hover: #5fafff;
    link-background-hover: transparent;
    link-style-hover: underline;
}

/* The filter looks like the message input: a rounded border, purple when focused. */
#filter {
    height: 3;
    margin: 0 1;
    padding: 0 1;
    background: $surface;
    border: round $surface-lighten-2;
}

#filter:focus {
    border: round $primary;
    background-tint: transparent;
}

SessionList {
    height: 1fr;
    padding: 0;
    border: none;
    background: $surface;
    scrollbar-background: $surface;
    scrollbar-background-hover: $surface;
    scrollbar-background-active: $surface;

    &:focus {
        border: none;
        background-tint: transparent;
    }

    & > .option-list--option-highlighted {
        background: $surface-lighten-1;
    }

    &:focus > .option-list--option-highlighted {
        background: $primary 30%;
    }

    & > .option-list--option-hover {
        background: $surface-lighten-1;
    }

    & > .option-list--option-disabled {
        padding: 0;
    }
}

/* Notifications, above the key hints (prototype/widgets.py NoticeStack). */
NoticeStack {
    height: auto;
    padding: 0 1;
}

Notice {
    height: auto;
    margin-top: 1;
    padding: 1 1;
    background: $surface-lighten-1;
    border-left: thick $primary;
}

Notice.-warning {
    border-left: thick $warning;
}

Notice.-error {
    border-left: thick $error;
}

#sidebar-keys {
    height: 1;
    padding: 0 2;
    margin: 1 0;
}

/* --- Session pane --- */
#main {
    width: 1fr;
    height: 1fr;
}

SessionHeader {
    height: auto;
    padding: 1 2;
    background: $surface;
}

SessionHeader #header-left {
    width: 1fr;
}

SessionHeader #header-right {
    width: auto;
}

/* The attach TUI's status bar, directly under the input. The bottom margin lines it up
 * with the key hints at the bottom of the sidebar. */
#status {
    height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
}

/* The transcript and detail views sit on $pane (prototype/panes.py PANE_BG): a step
 * darker than the surface around them, not black, so the edges don't glare. The
 * scrollbars are drawn on the same colour with a quiet thumb. */
#views,
#loading,
#views Conversation,
#views TranscriptView,
PaneView,
#activity {
    background: $pane;
}

/* The activity line: the last row of the conversation, on the conversation's colour.
 * It is always there (blank between turns), so the transcript never changes height.
 * The blank row under it is bottom padding, not margin, so it is the conversation's
 * colour too (a margin would show the input's colour). The left padding lines the
 * spinner up with the transcript's tool glyphs and message text. */
#activity {
    height: auto;
    padding: 0 2 1 4;
}

/* One column of padding on the left keeps the blocks' left rules off the sidebar's
 * divider; the scrollbar stays at the right edge. */
#views Conversation,
#views TranscriptView {
    padding-left: 1;
}

#views Conversation,
#views TranscriptView,
PaneView VerticalScroll {
    scrollbar-background: $pane;
    scrollbar-background-hover: $pane;
    scrollbar-background-active: $pane;
}

#views {
    height: 1fr;
}

#loading {
    height: 1fr;
    padding: 1 2;
}

/* Tool rows stay on one line each (see prototype/rows.py). */
#views ToolRow {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* Archie's replies: no coloured left rule and no "● Archie" header. The rule stays as
 * a transparent column so reply text lines up with the tool rows. The activity line
 * says when a reply is streaming, so the header's spinner isn't missed. */
#views AssistantMessage,
#views StreamingMessage {
    border-left: thick transparent;
}

#views AssistantMessage > .header,
#views StreamingMessage > .header {
    display: none;
}

/* Spacing between transcript rows. Tool rows stack with no gaps, even across
 * iterations; every other row (messages, notices, compaction, turn status) has a
 * one-line margin above and below. Textual collapses adjacent margins, so any two
 * neighbouring blocks are one blank line apart and a run of tool calls is solid. */
#views IterationBlock,
#views SubagentBlock {
    margin: 0;
}

#views UserMessage,
#views PromptMessage,
#views AssistantMessage,
#views StreamingMessage,
#views ErrorMessage,
#views CancelledMessage,
#views ClientErrorMessage,
#views ShellOutput,
#views CompactionEntry,
#views CompactionMarker,
#views TurnStatus {
    margin: 1 0;
}

/* A reply's last Markdown block would add its own bottom margin to the one above. */
#views AssistantMessage Markdown > *:last-child,
#views StreamingMessage Markdown > *:last-child {
    margin-bottom: 0;
}

/* Three lines by default; MessageInput still grows to its max-height. */
#input {
    min-height: 5;
    max-height: 10;
    margin: 0;
}

/* --- Detail views in the pane ---
 * The status block is one line with room above and below. Each section starts with a
 * full-width header band, which also divides it from the section before. */
PaneView {
    height: 1fr;
}

PaneView .pane-crumbs {
    height: 1;
    padding: 0 2;
    margin: 1 0;
}

PaneView .pane-body {
    height: 1fr;
    padding: 0;
}

PaneView .tool-card {
    height: auto;
    padding: 1 2;
    margin: 0 0 1 0;
    background: $surface;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

PaneView .section {
    height: auto;
}

PaneView .section-header {
    height: 1;
    padding: 0 2;
    background: $surface-lighten-1;
}

PaneView .section-title {
    width: 1fr;
    color: $secondary;
    text-style: bold;
}

PaneView .section-facts {
    width: auto;
    color: $muted;
}

PaneView .section-body {
    height: auto;
    padding: 1 2;
}

PaneView .section.-error .section-header {
    background: $error 25%;
}

PaneView .section.-error .section-title {
    color: $error;
}

/* --- Dialogs ---
 * archie.tcss gives every Screen (modal ones included) an opaque $surface background,
 * which beats a screen's DEFAULT_CSS. Restore the see-through backdrop here so the app
 * stays visible, and live, behind a dialog.
 */
Dialog {
    background: $background 60%;
}

Dialog.-pane {
    /* Nearly transparent: the session pane dims itself instead (#main.-dimmed), so the
     * sidebar stays bright and live. */
    background: $background 1%;
}

/* Tint doesn't cascade, so every widget in the pane takes it. */
#main.-dimmed, #main.-dimmed * {
    tint: $background 60%;
}

